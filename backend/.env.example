# ==============================
# JAN SETU BACKEND - ENVIRONMENT
# ==============================

# Database
DATABASE_URL=postgresql://jansetu_user:jansetu_pass@localhost:5432/jansetu_db

# JWT Auth
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AES field-level encryption key (32-byte urlsafe base64, generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=change-this-generate-a-real-fernet-key

# App
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,https://jansetu.vercel.app

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# OTP (mock provider for hackathon demo - swap for MSG91/Twilio in production)
OTP_MOCK_MODE=true
OTP_EXPIRY_SECONDS=300
